{
  "manifest_version": 3,
  "name": "TabRise",
  "version": "0.1.1",
  "description": "New tabs at the top, below pinned tabs. Tabs opened inside groups stay in their groups. Inspired by Arc.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "TabRise",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
